{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://field-transcriber.local/schemas/transcript-v1.json",
  "title": "Field transcript",
  "type": "object",
  "required": ["schema_version", "recording", "language", "segments", "run"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": "1.0"},
    "recording": {
      "type": "object",
      "required": ["sha256", "original_name"],
      "additionalProperties": false,
      "properties": {
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "original_name": {"type": "string", "minLength": 1}
      }
    },
    "language": {
      "type": "object",
      "required": ["code", "confidence"],
      "additionalProperties": false,
      "properties": {
        "code": {"type": "string", "minLength": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/segment"}
    },
    "run": {
      "type": "object",
      "required": ["model", "compute_type", "created_at"],
      "additionalProperties": true,
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "compute_type": {"type": "string", "minLength": 1},
        "created_at": {"type": "string", "format": "date-time"},
        "duration_seconds": {"type": ["number", "null"], "minimum": 0},
        "peak_gpu_memory_mb": {"type": ["integer", "null"], "minimum": 0}
      }
    }
  },
  "$defs": {
    "word": {
      "type": "object",
      "required": ["text", "start", "end", "confidence"],
      "additionalProperties": false,
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "start": {"type": ["number", "null"], "minimum": 0},
        "end": {"type": ["number", "null"], "minimum": 0},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
      }
    },
    "segment": {
      "type": "object",
      "required": ["start", "end", "speaker", "text", "confidence", "words"],
      "additionalProperties": false,
      "properties": {
        "start": {"type": "number", "minimum": 0},
        "end": {"type": "number", "minimum": 0},
        "speaker": {"type": ["string", "null"]},
        "text": {"type": "string", "minLength": 1},
        "confidence": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
        "words": {"type": "array", "items": {"$ref": "#/$defs/word"}}
      }
    }
  }
}
