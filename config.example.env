# VPS controller configuration. Copy to config.env and keep it untracked.
FIELD_TRANSCRIBER_ROOT=/home/assela/field-transcriber/files
FIELD_TRANSCRIBER_WORKER_HOST=gpu-worker
FIELD_TRANSCRIBER_WORKER_USER=assela
FIELD_TRANSCRIBER_WORKER_IMAGE=field-transcriber-worker:local
FIELD_TRANSCRIBER_REMOTE_ROOT=/home/assela/field-transcriber-jobs
FIELD_TRANSCRIBER_CLAIM_LEASE_SECONDS=300
FIELD_TRANSCRIBER_HEARTBEAT_SECONDS=60
FIELD_TRANSCRIBER_HF_TOKEN_ENV=HF_TOKEN
FIELD_TRANSCRIBER_PYTHON=python3
FIELD_TRANSCRIBER_WORKER_MODE=ssh
# Runpod mode uses names of runtime secret variables, never secret values.
FIELD_TRANSCRIBER_RUNPOD_ENDPOINT_ID=
FIELD_TRANSCRIBER_RUNPOD_API_KEY_ENV=RUNPOD_API_KEY
FIELD_TRANSCRIBER_REMOTE_EXECUTION_TIMEOUT_MS=7200000
FIELD_TRANSCRIBER_REMOTE_TTL_MS=10800000
FIELD_TRANSCRIBER_REMOTE_POLL_SECONDS=10
FIELD_TRANSCRIBER_REMOTE_RESOLUTION_SECONDS=1800
FIELD_TRANSCRIBER_TRANSFER_RETENTION_SECONDS=86400
FIELD_TRANSCRIBER_OBJECT_STORE_ENDPOINT=
FIELD_TRANSCRIBER_OBJECT_STORE_BUCKET=
FIELD_TRANSCRIBER_OBJECT_STORE_REGION=us-east-1
FIELD_TRANSCRIBER_OBJECT_STORE_ACCESS_KEY_ENV=S3_ACCESS_KEY_ID
FIELD_TRANSCRIBER_OBJECT_STORE_SECRET_KEY_ENV=S3_SECRET_ACCESS_KEY
FIELD_TRANSCRIBER_OBJECT_URL_TTL_SECONDS=10800
